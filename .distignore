# Directories
/.aider
/.claude
/.cursor
/.github
/.idea
/.wordpress-org
/bin
/docs
/tests
/vendor
!/vendor/autoload.php
!/vendor/composer/

# Files
#
# `composer.json` is deliberately *not* excluded: the archive ships
# `vendor/autoload.php`, and a `vendor` directory without an accompanying
# `composer.json` is flagged by the WordPress.org plugin check.
/.aider.conf.yml
/.distignore
/.editorconfig
/.gitattributes
/.gitignore
# In a git worktree `.git` is a file, which `dist-archive` does not skip on its own.
/.git
/.phpunit.result.cache
/.sonarcloud.properties
/.windsurfrules
/.wp-env.json
/.wp-env.override.json
/AGENTS.local.md
/AGENTS.md
/CLAUDE.local.md
/CLAUDE.md
/CONVENTIONS.local.md
/CONVENTIONS.md
/README.md
/composer.lock
/docker-compose.yml
/package-lock.json
/package.json
/phpcs.xml
/phpstan-bootstrap.php
/phpstan.neon
/phpunit-integration.xml.dist
/phpunit.xml.dist
/playwright.config.ts
/typos.toml
