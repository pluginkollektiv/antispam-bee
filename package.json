{
	"name": "@pluginkollektiv/antispam-bee",
	"version": "3.0.0",
	"description": "Antispam Bee blocks spam comments and trackbacks effectively and without captchas.",
	"author": "pluginkollektiv",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"env:test:start": "wp-env start --config=.wp-env.test.json",
		"env:test:stop": "wp-env stop --config=.wp-env.test.json",
		"env:test:clean": "wp-env reset --config=.wp-env.test.json",
		"env:test:destroy": "wp-env destroy --config=.wp-env.test.json",
		"test:integration": "wp-env run cli --config=.wp-env.test.json --env-cwd=wp-content/plugins/\"$(basename \"$PWD\")\" -- composer test:integration",
		"test:integration:multisite": "wp-env run cli --config=.wp-env.test.json --env-cwd=wp-content/plugins/\"$(basename \"$PWD\")\" -- env WP_MULTISITE=1 composer test:integration",
		"test:e2e": "wp-scripts test-playwright",
		"test:e2e:ui": "wp-scripts test-playwright --ui",
		"test:e2e:debug": "wp-scripts test-playwright --debug"
	},
	"dependencies": {
		"@playwright/test": "^1.61.1",
		"@wordpress/e2e-test-utils-playwright": "^1.50.0",
		"@wordpress/env": "^11.15.0",
		"@wordpress/scripts": "^32.6.0"
	}
}
